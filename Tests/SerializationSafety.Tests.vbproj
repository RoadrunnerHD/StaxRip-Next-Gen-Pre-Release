<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <RootNamespace>StaxRip</RootNamespace><AssemblyName>StaxRipNG</AssemblyName>
    <OptionStrict>On</OptionStrict><EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableUnsafeBinaryFormatterSerialization>true</EnableUnsafeBinaryFormatterSerialization>
    <NoWarn>SYSLIB0011;SYSLIB0050</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Import Include="System" /><Import Include="System.Linq" /><Import Include="System.Collections.Generic" />
    <Compile Include="../Source/General/SerializationCompatibility.vb" Link="SerializationCompatibility.vb" />
    <Compile Include="../Source/General/CompatibleDataFormatter.vb" Link="CompatibleDataFormatter.vb" />
    <Compile Include="../Source/General/CustomCultureInfo.vb" Link="CustomCultureInfo.vb" />
    <Compile Include="SerializationFixtures.vb" /><Compile Include="SerializationSafety.Tests.vb" />
    <PackageReference Include="System.Formats.Nrbf" Version="10.0.12" />
    <PackageReference Include="System.Runtime.Serialization.Formatters" Version="10.0.12" />
  </ItemGroup>
</Project>
