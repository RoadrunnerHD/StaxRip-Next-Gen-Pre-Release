<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>StaxRip</RootNamespace>
    <OptionStrict>On</OptionStrict>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Source/General/HttpFileDownload.vb" Link="HttpFileDownload.vb" />
    <Compile Include="../Source/General/ToolDirectoryTransaction.vb" Link="ToolDirectoryTransaction.vb" />
    <Compile Include="../Source/General/EncoderShellCommand.vb" Link="EncoderShellCommand.vb" />
    <Compile Include="FileSafety.Tests.vb" />
  </ItemGroup>
</Project>
